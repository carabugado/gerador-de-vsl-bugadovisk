# ── MiniMax: clone de voz + TTS ──────────────────────────────────────────
# A chave funciona OMITINDO o GroupId: as chamadas vão sem ?GroupId=
MINIMAX_API_KEY=

# ── Anthropic: visão do Claude na etapa visual (OPCIONAL) ────────────────
# Sem crédito, deixe vazio: a visual sai só do CLIP e você confere o
# contact sheet no olho.
ANTHROPIC_API_KEY=

# ── Motor da detecção visual ─────────────────────────────────────────────
#   cloud → CLIP (+ Claude, se houver chave). NÃO usa OpenCV.  ← use este
#   clip  → só CLIP
#   local → OpenCV. Marcou ~73% do vídeo de lixo numa VSL real.
TDP_VISUAL_ENGINE=cloud

# ── Hotwords: enviesa o Whisper pelo nome antigo (grafa certo) ───────────
TDP_HOTWORDS=1

# ── Modelo do Whisper (large-v3 é o padrão) ─────────────────────────────
TDP_WHISPER_MODEL=large-v3
